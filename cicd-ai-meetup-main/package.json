{
  "name": "coffee-break-api",
  "version": "1.0.0",
  "description": "Tiny demo app for the CI/CD + AI meetup",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.js\"",
    "pretest:ci": "node -e \"fs.mkdirSync('reports',{recursive:true})\"",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.xml \"test/**/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-include=\"src/**\" \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5"
  }
}
